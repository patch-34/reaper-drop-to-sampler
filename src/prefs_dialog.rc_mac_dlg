#ifndef SWELL_DLG_FLAGS_AUTOGEN
#define SWELL_DLG_FLAGS_AUTOGEN SWELL_DLG_WS_FLIPPED|SWELL_DLG_WS_NOAUTOSIZE
#endif

#ifndef SET_IDD_PREFS_STYLE
#define SET_IDD_PREFS_STYLE SWELL_DLG_FLAGS_AUTOGEN|SWELL_DLG_WS_CHILD
#endif
#ifdef SET_IDD_PREFS_SCALE
SWELL_DEFINE_DIALOG_RESOURCE_BEGIN(IDD_PREFS,SET_IDD_PREFS_STYLE,"",260,236,SET_IDD_PREFS_SCALE)
#else
SWELL_DEFINE_DIALOG_RESOURCE_BEGIN2(IDD_PREFS,SET_IDD_PREFS_STYLE,"",260,236)
#endif
BEGIN
LTEXT           "Sampler:",IDC_LABEL_SAMPLER,7,7,240,9
COMBOBOX        IDC_SAMPLER_COMBO,7,17,240,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
LTEXT           "Rec-arm for new tracks:",IDC_LABEL_RECARM,7,37,240,9
COMBOBOX        IDC_RECARM_COMBO,7,47,240,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
LTEXT           "Show sampler:",IDC_LABEL_SHOW,7,67,240,9
COMBOBOX        IDC_SHOW_COMBO,7,77,240,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
LTEXT           "If sampler exists:",IDC_LABEL_EXISTING,7,97,240,9
COMBOBOX        IDC_EXISTING_COMBO,7,107,240,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
LTEXT           "Multiple media:",IDC_LABEL_MULTI,7,127,240,9
COMBOBOX        IDC_MULTI_COMBO,7,137,240,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
LTEXT           "Multiple samplers on one track:",IDC_LABEL_MULTISAMP,7,157,240,9
COMBOBOX        IDC_MULTISAMP_COMBO,7,167,240,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
CONTROL         "Debug (log drops to the REAPER console)",IDC_DEBUG_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,191,240,10
END
#ifdef SET_IDD_PREFS_SCALE
SWELL_DEFINE_DIALOG_RESOURCE_END(IDD_PREFS)
#else
SWELL_DEFINE_DIALOG_RESOURCE_END2(IDD_PREFS)
#endif



//EOF

